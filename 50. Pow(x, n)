class Solution:
    def myPow(self, x: float, n: int) -> float:
        if n == 0:
            return 1
        if n < 0:
            return 1 / self.myPow(x, -n)
        if n % 2 == 0:
            sub_result = self.myPow(x, n // 2)
            return sub_result * sub_result
        else:
            sub_result = self.myPow(x, (n - 1) // 2)
            return x * sub_result * sub_result
